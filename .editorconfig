# Coherente con todo el monorepo (Node/TypeScript, YAML de workflows y Terraform).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Markdown: el salto de línea final puede ser significativo y los ficheros usan
# además tablas y listas alineadas a mano.
[*.md]
trim_trailing_whitespace = false
