# Configuración de entorno para la API de TV Hub (backend).
# Copia este archivo a `.env` en local y ajusta los valores.
# NUNCA subas `.env` al repositorio ni hardcodees secretos.

NODE_ENV=development

# Puerto HTTP de la API.
PORT=3000

# Cadena de conexión a MongoDB / DocumentDB (compatible con la API de MongoDB ~4.0).
# Formato:
#   mongodb://usuario:contraseña@host:27017/tvhub?authSource=admin&tls=true&tlsCAFile=<ruta>
# En local, con mongodb-memory-server o MongoDB de desarrollo:
#   mongodb://127.0.0.1:27017/tvhub
MONGODB_URI=mongodb://127.0.0.1:27017/tvhub

# Orígenes permitidos por CORS, separados por comas.
# En local, el frontend se sirve desde estos puertos.
# Si se deja vacío, se refleja el `Origin` de cada petición (las cookies siguen
# limitadas por `SameSite=Strict`).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Autenticación JWT
# ---------------------------------------------------------------------------
# Secretos de firma. OBLIGATORIOS: la API responde 500 sin ellos y NO tienen
# valor por defecto. Usa cadenas aleatorias largas (p. ej. `openssl rand -hex 32`)
# y distintos entre sí. Colócalos en `.env` o en el gestor de secretos; nunca
# en el repositorio.
JWT_SECRET=cambia-este-secreto-de-acceso
JWT_REFRESH_SECRET=cambia-este-secreto-de-refresh

# Vida de cada token. Formato `15m`, `2h`, `7d`...
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
